DB_PASSWORD=change-me
ADMIN_PASSWORD=change-me
# openssl rand -hex 32
SESSION_SECRET=
WEB_PORT=
TRADING_MODE=PAPER_TRADING

# AI: none | gemini | groq | anthropic | openai   (gemini và groq có gói miễn phí)
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DAILY_CALL_LIMIT=500

# Quản trị rủi ro (Giai đoạn 4). Vốn nhập tay cho đến khi có Portfolio đọc từ Binance.
ACCOUNT_EQUITY_USDT=1000
RISK_PCT=0.5

# Binance (Giai đoạn 5: CHỈ ĐỌC). Tạo key chỉ bật "Enable Reading", TẮT rút tiền, giới hạn IP = IP VPS.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Chế độ: ANALYSIS_ONLY | PAPER_TRADING | BINANCE_TESTNET (LIVE: xem docs/LIVE_RUNBOOK.md)
# PAPER_TRADING: đề xuất được tự khớp trên sổ giả lập bằng bid/ask thật + phí + trượt giá.
# BINANCE_TESTNET cần BINANCE_ENV=testnet và key tạo ở https://testnet.binance.vision (khác key thật).
BINANCE_ENV=mainnet
PAPER_START_EQUITY=1000

# Thực thi lệnh (Giai đoạn 7). Chỉ BINANCE_TESTNET và LIVE gửi lệnh lên sàn, và chỉ sau khi:
# bật công tắc ở trang Cài đặt + bấm xác nhận từng đề xuất. LIVE còn cần ACK bên dưới VÀ đạt toàn bộ
# ngưỡng paper/backtest, nếu không backend từ chối đặt lệnh.
# LIVE_TRADING_ACK=I_UNDERSTAND_REAL_MONEY_RISK
ORDER_SLIP_BUFFER_PCT=0.10
EXIT_SLIP_BUFFER_PCT=0.50
MAX_ORDER_FAILURES=3

# Giới hạn vốn LIVE (Giai đoạn 8). <= 0 nghĩa là CHẶN hoàn toàn, không phải không giới hạn.
LIVE_MAX_ORDER_USDT=50
LIVE_MAX_DAILY_LOSS_USDT=20
LIVE_MAX_OPEN_POSITIONS=2

# Cảnh báo Telegram (tuỳ chọn): tạo bot qua @BotFather, lấy chat id của bạn
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tự động mua/thoát (chỉ BINANCE_TESTNET và LIVE; PAPER vốn đã tự động). Công tắc bật ở trang Cài đặt, mặc định TẮT.
AUTO_MAX_ORDER_USDT=50
AUTO_MAX_BUYS_PER_DAY=3
AUTO_COOLDOWN_S=14400
AUTO_RETRY_S=300
